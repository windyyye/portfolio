---
/**
 * Shared layout — implements DESIGN.md §5 (header, footer) and §7 (a11y).
 * Every page passes a title; description falls back to the site default.
 */
import '../styles/global.css';
import { site, links } from '../config';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = `${title} · ${site.name}`;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/work/', label: 'Work' },
  { href: '/how-i-work/', label: 'How I work' },
  { href: '/log/', label: 'Build log' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

// Normalize so "/work/" and "/" match their nav items.
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const footerLinks = [
  { href: links.email, label: 'Email' },
  { href: links.github, label: 'GitHub' },
  { href: links.linkedin, label: 'LinkedIn' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container site-header-inner">
        <a class="site-name" href="/">{site.name}</a>
        <nav aria-label="Main">
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={currentPath === item.href ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="label">Elsewhere</p>
        <ul class="footer-links">
          {
            footerLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
        <p class="colophon text-muted">
          {site.name} · built with AI agents · Malaysia (UTC+8)
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 2rem;
    padding-block: 0.75rem;
  }

  .site-name {
    font-weight: 500;
    font-size: 1rem;
    text-decoration: none;
  }

  .site-name:hover {
    color: var(--color-text);
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  nav a {
    display: inline-block;
    padding: 0.875rem 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--color-text);
  }

  nav a:hover {
    color: var(--color-text-muted);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  main {
    flex: 1;
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: 2rem 2.5rem;
  }

  .footer-links {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .colophon {
    font-size: 0.875rem;
    margin: 0;
  }
</style>
