---
/**
 * Shared layout: <head> with title/description, header nav, footer.
 * Every page passes a title; description falls back to the site default.
 */
import { site, links } from '../config';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = `${title} · ${site.name}`;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/work/', label: 'Work' },
  { href: '/how-i-work/', label: 'How I work' },
  { href: '/log/', label: 'Build log' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

// Normalize so "/work/" and "/" match their nav items.
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const footerLinks = [
  { href: links.email, label: 'Email' },
  { href: links.github, label: 'GitHub' },
  { href: links.linkedin, label: 'LinkedIn' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <div class="inner">
        <a class="site-name" href="/">{site.name}</a>
        <nav aria-label="Main">
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <div class="inner">
        <slot />
      </div>
    </main>

    <footer>
      <div class="inner">
        <p>
          Built in the open: I write the specs, direct AI coding agents, and review every commit.
        </p>
        <ul class="footer-links">
          {
            footerLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
        <p class="muted">Malaysia (UTC+8)</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --text: #1c1c1c;
    --bg: #fdfdfc;
    --accent: #0b5cad;
    --muted: #555555;
    --border: #e2e2df;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      'Helvetica Neue',
      Arial,
      sans-serif;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .inner {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 1.25rem;
    width: 100%;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
    background: var(--bg);
    padding: 0.5rem 1rem;
    z-index: 10;
  }

  header {
    border-bottom: 1px solid var(--border);
  }

  header .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
  }

  .site-name {
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
    color: var(--text);
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
  }

  nav a {
    color: var(--text);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
  }

  main {
    flex: 1;
    padding-top: 2.5rem;
    padding-bottom: 3rem;
  }

  footer {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    font-size: 0.9rem;
  }

  footer p {
    margin: 0 0 0.5rem;
  }

  .footer-links {
    list-style: none;
    margin: 0 0 0.5rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
  }

  a {
    color: var(--accent);
  }

  .muted {
    color: var(--muted);
  }
</style>
