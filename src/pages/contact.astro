---
/**
 * Contact — DESIGN.md v2: a letter to the reader. Two parts: say hi,
 * fund the ink. The humor lives in the small text, where it belongs.
 *
 * ┌─ PROTOTYPE ──────────────────────────────────────────────────────┐
 * │ feat/21-coffee-proto (throwaway branch, do not merge).           │
 * │ Four variants of the coffee-click moment, switchable via         │
 * │ ?variant=current|spotlight|bubble|rain + floating bar (hidden    │
 * │ in PROD builds). Question: how should the click moment feel so   │
 * │ it encourages buying coffee — uncrowded, screen-focusing,        │
 * │ rounded confetti spread page-wide?                               │
 * └──────────────────────────────────────────────────────────────────┘
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { links, site } from '../config';
import { createFundTheInkState } from '../scripts/fund-the-ink-state.mjs';
  import confetti from 'canvas-confetti';

const channels = [
  { label: 'Email', href: links.email, display: 'windye0407@gmail.com' },
  { label: 'GitHub', href: links.github, display: 'github.com/windyyye' },
  { label: 'LinkedIn', href: links.linkedin, display: 'linkedin.com/in/windy-e-8088712b4' },
];
---

<BaseLayout
  title="Contact"
  description={`Say hi to ${site.name} — or fund the ink. Email, GitHub, LinkedIn, and a tip jar. Malaysia (UTC+8).`}
>
  <section class="section">
    <div class="container measure">
      <p class="label">Vol. I · contact</p>
      <h1>Say hi</h1>
      <p>
        The diary doesn't sell anything, but the person writing it does answer messages. Email
        is fastest — I'm in Malaysia (UTC+8).
      </p>
      <ul class="channels">
        {
          channels.map((channel) => (
            <li class="channel">
              <span class="label">{channel.label}</span>
              <a href={channel.href}>{channel.display}</a>
            </li>
          ))
        }
      </ul>

      <div class="fund">
        <button
          id="coffee-button"
          class="coffee-button"
          aria-label="Click the coffee. It has opinions."
        >
          <img
            src="/images/kit/coffee-2026-10-07.svg"
            alt=""
            width="150"
            height="120"
            class="coffee"
          />
        </button>
        <p class="coffee-hint" aria-hidden="true">psst. click the coffee.</p>
        <p id="coffee-message" class="coffee-message" role="status"></p>
        <div id="egg-bubble" class="egg-bubble" hidden></div>
        <h2>Fund the ink</h2>
        <p>
          The diary is free. The coffee that fuels it is not. So for readers who just want to
          <em>give me money without me servicing them</em> — this one's for you, WAHAHA.
        </p>
        <p class="text-muted">
          Hosting is already free; tips go straight to the coffee supply and the author's
          ego.
        </p>
        {
          links.kofi && (
            <p>
              <a class="btn" href={links.kofi}>Buy the author a cup →</a>
            </p>
          )
        }
      </div>
    </div>
  </section>

  <!-- PROTOTYPE vessels: spotlight uses these two -->
  <div id="egg-overlay" class="egg-overlay" hidden>
    <p id="egg-overlay-phrase" class="egg-overlay-phrase"></p>
  </div>
  <div id="egg-banner" class="egg-banner" hidden></div>
</BaseLayout>

<script>
  // PROTOTYPE: variant switcher + per-variant presentation for the
  // coffee easter egg. The state machine is the real one, untouched —
  // the adapter only chooses HOW a pop looks.
  import { createFundTheInkState } from '../scripts/fund-the-ink-state.mjs';
  import confetti from 'canvas-confetti';

  const params = new URLSearchParams(location.search);
  const variant = params.get('variant') ?? 'current';
  const VARIANTS = ['current', 'spotlight', 'bubble', 'rain'];
  const NAMES = {
    current: 'current (shipped)',
    spotlight: 'spotlight — grey dim, huge phrase',
    bubble: 'bubble — vignette, speech bubble, nudge',
    rain: 'rain — full-width confetti rain',
  };

  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  // ── shared: the real state machine picks the words ──
  const state = createFundTheInkState();

  // ── adapter-side click window (readout + nudge timing only) ──
  let windowClicks = [];
  function noteClick() {
    const now = Date.now();
    windowClicks = windowClicks.filter((c) => now - c < 10_000);
    windowClicks.push(now);
    return windowClicks.length;
  }

  // ── hide every phrase vessel (overlay / banner / bubble) ──
  function clearVessels() {
    for (const id of ['egg-overlay', 'egg-banner', 'egg-bubble']) {
      document.getElementById(id)?.setAttribute('hidden', '');
    }
  }

  // ── confetti via canvas-confetti (MIT, ~6KB bundled) ──
  // The single sanctioned exception to the motion law (DESIGN.md §6).
  const EGG_COLORS = ['#2B2520', '#FF48B0', '#0078BF', '#FAF6EE'];

  function burstConfetti({ intensity = 1, origin = null } = {}) {
    const o = origin ?? coffeeCenter();
    confetti({
      particleCount: Math.round(60 * intensity),
      spread: 100,
      startVelocity: 38 + 12 * intensity,
      scalar: 0.9 + 0.3 * intensity,
      shapes: ['circle', 'square'],
      ticks: 220,
      colors: EGG_COLORS,
      origin: { x: o.x / innerWidth, y: o.y / innerHeight },
      disableForReducedMotion: true,
    });
  }

  function coffeeCenter() {
    const rect = document.getElementById('coffee-button')?.getBoundingClientRect();
    return rect
      ? { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 }
      : { x: innerWidth / 2, y: innerHeight / 3 };
  }

  const presentations = {
    current: {
      onPop(text) {
        clearVessels();
        document.getElementById('coffee-message').textContent = text;
      },
      burst() { burstConfetti({ intensity: 0.7 }); },
    },
    spotlight: {
      onPop(text) {
        clearVessels();
        const overlay = document.getElementById('egg-overlay');
        document.getElementById('egg-overlay-phrase').textContent = text;
        overlay.hidden = false;
        overlay.classList.add('on');
        spawnConfetti({ originX: innerWidth / 2, originY: innerHeight * 0.35, amount: 60, fallDistance: innerHeight * 0.5 });
        setTimeout(() => overlay.classList.remove('on'), 1400);
        setTimeout(() => overlay.setAttribute('hidden', ''), 1800);
      },
      burst() { burstConfetti({ intensity: 1.2, origin: { x: innerWidth / 2, y: innerHeight * 0.35 } }); },
    },
    bubble: {
      onPop(text, { nudge }) {
        clearVessels();
        const bubble = document.getElementById('egg-bubble');
        bubble.textContent = nudge ? `${text} …the jar's right there ↓` : text;
        bubble.hidden = false;
        burstConfetti({ intensity: 1.15 });
        setTimeout(() => bubble.setAttribute('hidden', ''), 2300);
      },
      burst() { burstConfetti({ intensity: 1.15 }); },
    },
    rain: {
      onPop(text) {
        clearVessels();
        const banner = document.getElementById('egg-banner');
        banner.textContent = text;
        banner.hidden = false;
        banner.classList.add('on');
        for (let i = 0; i < 3; i++) {
          setTimeout(() => burstConfetti({ intensity: 1, origin: { x: innerWidth * (0.2 + 0.3 * i), y: -0.05 } }), i * 180);
        }
        setTimeout(() => banner.classList.remove('on'), 1500);
        setTimeout(() => banner.setAttribute('hidden', ''), 1900);
      },
      burst() { spawnConfetti({ originX: innerWidth / 2, originY: -20, amount: 40, fallDistance: innerHeight }); },
    },
  };

  const mode = presentations[variant] ?? presentations.current;
  const coffee = document.getElementById('coffee-button');
  const msg = document.getElementById('coffee-message');

  coffee.addEventListener('click', () => {
    const inWindow = noteClick();
    const result = state.recordClick();
    if (result.message) msg.textContent = result.message;
    mode.onPop(result.message ?? '', { nudge: inWindow >= 5 });
    updateBar();
  });

  // ── floating switcher + state readout (hidden in production builds) ──
  let readout = null;
  function updateBar() {
    if (!readout) return;
    readout.textContent = `clicks in window: ${Math.min(windowClicks.length, 5)}`;
  }

  if (import.meta.env.PROD !== true) {
    const bar = document.createElement('div');
    bar.className = 'proto-bar';
    bar.innerHTML = `
      <button class="proto-arrow" data-dir="-1" aria-label="Previous variant">←</button>
      <span class="proto-label"></span>
      <button class="proto-arrow" data-dir="1" aria-label="Next variant">→</button>
      <span class="proto-readout"></span>`;
    document.body.appendChild(bar);
    readout = bar.querySelector('.proto-readout');
    const label = bar.querySelector('.proto-label');
    function refresh() {
      label.textContent = `${variant} · ${NAMES[variant]}`;
    }
    function cycle(dir) {
      const next = VARIANTS[(VARIANTS.indexOf(variant) + dir + VARIANTS.length) % VARIANTS.length];
      const u = new URL(location);
      u.searchParams.set('variant', next);
      location.replace(u);
    }
    bar.querySelectorAll('.proto-arrow').forEach((b) =>
      b.addEventListener('click', () => cycle(Number(b.dataset.dir)))
    );
    addEventListener('keydown', (e) => {
      const tag = document.activeElement?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      if (e.key === 'ArrowLeft') cycle(-1);
      if (e.key === 'ArrowRight') cycle(1);
    });
    refresh();
    updateBar();
  }
</script>

<style>
  /* PROTOTYPE styles — throwaway branch feat/21-coffee-proto */
  [hidden] {
    display: none !important;
  }

  .egg-overlay {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(43, 37, 32, 0);
    transition: background 180ms ease;
    pointer-events: none;
  }

  .egg-overlay.on {
    background: rgba(43, 37, 32, 0.65);
  }

  .egg-overlay-phrase {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.4rem);
    color: var(--paper);
    text-align: center;
    max-width: 22ch;
    margin: 0;
  }

  .egg-banner {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3vw, 2rem);
    text-align: center;
    padding: var(--space-3);
    transform: translateY(-100%);
    transition: transform 200ms ease;
  }

  .egg-banner.on {
    transform: translateY(0);
  }

  .fund {
    position: relative;
  }

  .channels {
    list-style: none;
    margin: var(--space-4) 0 var(--space-3);
    padding: 0;
  }

  .channel {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding-block: 0.875rem;
    border-top: 1.5px solid var(--ink-20);
  }

  .channel .label {
    margin: 0;
  }

  .channel:last-child {
    border-bottom: 1.5px solid var(--ink-20);
  }

  .coffee-button {
    display: block;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
  }

  .coffee-hint {
    font-family: var(--font-hand);
    font-size: 1.2rem;
    color: var(--ink-70);
    transform: rotate(-1.2deg);
    margin: 0 0 var(--space-3);
  }

  .coffee-message {
    font-family: var(--font-hand);
    font-size: 1.35rem;
    line-height: 1.35;
    color: var(--ink);
    min-height: 1.4em;
    margin: 0 0 var(--space-2);
  }

  .egg-bubble {
    position: absolute;
    left: 170px;
    top: -10px;
    z-index: 40;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 18px 18px 18px 4px;
    font-family: var(--font-hand);
    font-size: 1.45rem;
    line-height: 1.3;
    padding: var(--space-2) var(--space-3);
    max-width: 18ch;
    box-shadow: 0 0 60px 30px rgba(250, 246, 238, 0.9);
  }

  /* .proto-piece / .proto-bar styles live in global.css — these
     elements are created by JS, so scoped styles never reach them. */
</style>
