---
/**
 * Contact — DESIGN.md v2: a letter to the reader. Two parts: say hi,
 * fund the ink. The humor lives in the small text, where it belongs.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { links, site } from '../config';
import { createFundTheInkState } from '../scripts/fund-the-ink-state.mjs';

const channels = [
  { label: 'Email', href: links.email, display: 'windye0407@gmail.com' },
  { label: 'GitHub', href: links.github, display: 'github.com/windyyye' },
  { label: 'LinkedIn', href: links.linkedin, display: 'linkedin.com/in/windy-e-8088712b4' },
];
---

<BaseLayout
  title="Contact"
  description={`Say hi to ${site.name} — or fund the ink. Email, GitHub, LinkedIn, and a tip jar. Malaysia (UTC+8).`}
>
  <section class="section">
    <div class="container measure">
      <p class="label">Vol. I · contact</p>
      <h1>Say hi</h1>
      <p>
        The diary doesn't sell anything, but the person writing it does answer messages. Email
        is fastest — I'm in Malaysia (UTC+8).
      </p>
      <ul class="channels">
        {
          channels.map((channel) => (
            <li class="channel">
              <span class="label">{channel.label}</span>
              <a href={channel.href}>{channel.display}</a>
            </li>
          ))
        }
      </ul>

      <div class="fund">
        <button
          id="coffee-button"
          class="coffee-button"
          aria-label="Click the coffee. It has opinions."
        >
          <img
            src="/images/kit/coffee-2026-10-07.svg"
            alt=""
            width="150"
            height="120"
            class="coffee"
          />
        </button>
        <p class="coffee-hint" aria-hidden="true">psst. click the coffee.</p>
        <p id="coffee-message" class="coffee-message" role="status"></p>
        <h2>Fund the ink</h2>
        <p>
          The diary is free. The coffee that fuels it is not. So for readers who just want to
          <em>give me money without me servicing them</em> — this one's for you, WAHAHA.
        </p>
        <p class="text-muted">
          Hosting is already free; tips go straight to the coffee supply and the author's
          ego.
        </p>
        {
          links.kofi && (
            <p>
              <a class="btn" href={links.kofi}>Buy the author a cup →</a>
            </p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // The tip-jar easter egg — DOM adapter for the state machine.
  import { createFundTheInkState } from '../scripts/fund-the-ink-state.mjs';

  const coffee = document.getElementById('coffee-button');
  const message = document.getElementById('coffee-message');

  if (coffee && message) {
    const state = createFundTheInkState();
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const colors = ['#2B2520', '#FF48B0', '#0078BF', '#FAF6EE'];

    coffee.addEventListener('click', () => {
      const { message: text, pop } = state.recordClick();
      if (!text) return;

      message.textContent = text;

      if (pop && !reducedMotion.matches) {
        const rect = coffee.getBoundingClientRect();
        for (let i = 0; i < 24; i++) {
          const piece = document.createElement('span');
          piece.className = 'confetti-piece';
          piece.style.left = `${rect.left + rect.width / 2 + (Math.random() * 80 - 40)}px`;
          piece.style.top = `${rect.top + rect.height / 2}px`;
          piece.style.background = colors[i % colors.length];
          piece.style.setProperty('--dx', `${Math.random() * 260 - 130}px`);
          piece.style.setProperty('--rot', `${Math.random() * 540 - 270}deg`);
          piece.style.animationDelay = `${Math.random() * 120}ms`;
          document.body.appendChild(piece);
          piece.addEventListener('animationend', () => piece.remove());
          setTimeout(() => piece.remove(), 1800);
        }
      }
    });
  }
</script>

<style>
  .channels {
    list-style: none;
    margin: var(--space-4) 0 var(--space-3);
    padding: 0;
  }

  .channel {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding-block: 0.875rem;
    border-top: 1.5px solid var(--ink-20);
  }

  .channel .label {
    margin: 0;
  }

  .channel:last-child {
    border-bottom: 1.5px solid var(--ink-20);
  }

  .fund {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 2px dotted var(--ink-30);
  }

  .coffee {
    display: block;
    margin-bottom: var(--space-3);
  }

  .coffee-button {
    display: block;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
  }

  .coffee-hint {
    font-family: var(--font-hand);
    font-size: 1.2rem;
    color: var(--ink-70);
    transform: rotate(-1.2deg);
    margin: 0 0 var(--space-3);
  }

  .coffee-message {
    font-family: var(--font-hand);
    font-size: 1.35rem;
    line-height: 1.35;
    color: var(--ink);
    min-height: 1.4em;
    margin: 0 0 var(--space-2);
  }
</style>
