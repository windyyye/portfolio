---
/**
 * Contact — DESIGN.md §8: rows (mono label left, value right), primary email
 * button, timezone note. Real content from day one.
 * TODO(Windy): email and LinkedIn are placeholders from src/config.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { links, site } from '../config';

const channels = [
  { label: 'GitHub', href: links.github },
  { label: 'LinkedIn', href: links.linkedin },
];
---

<BaseLayout
  title="Contact"
  description={`How to reach ${site.name}: email, GitHub, and LinkedIn. Based in Malaysia (UTC+8).`}
>
  <section class="section">
    <div class="container measure">
      <p class="label">Contact</p>
      <h1>Get in touch</h1>
      <p>
        The fastest way to reach me is email. I'm in Malaysia (UTC+8) and reply within a day.
      </p>
      <p><a class="btn btn-primary" href={links.email}>Email me</a></p>
      <ul class="channels">
        {
          channels.map((channel) => (
            <li class="channel">
              <span class="label">{channel.label}</span>
              <a href={channel.href}>{channel.href.replace(/^https?:\/\/(www\.)?/, '')}</a>
            </li>
          ))
        }
      </ul>
      <p class="text-muted">An Upwork profile will be linked here once it's live.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .channels {
    list-style: none;
    margin: 2rem 0 1rem;
    padding: 0;
  }

  .channel {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem 2rem;
    padding-block: 0.875rem;
    border-top: 1px solid var(--color-border);
  }

  .channel .label {
    margin: 0;
  }

  .channel:last-child {
    border-bottom: 1px solid var(--color-border);
  }
</style>
