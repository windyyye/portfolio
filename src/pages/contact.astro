---
/**
 * Contact — DESIGN.md v2: a letter to the reader. Two parts: say hi,
 * fund the ink. The humor lives in the small text, where it belongs.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { links, site } from '../config';

const channels = [
  { label: 'Email', href: links.email, display: 'windye0407@gmail.com' },
  { label: 'GitHub', href: links.github, display: 'github.com/windyyye' },
  { label: 'LinkedIn', href: links.linkedin, display: 'linkedin.com/in/windy-e-8088712b4' },
];
---

<BaseLayout
  title="Contact"
  description={`Say hi to ${site.name} — or fund the ink. Email, GitHub, LinkedIn, and a tip jar. Malaysia (UTC+8).`}
>
  <section class="section">
    <div class="container measure">
      <p class="label">Vol. I · contact</p>
      <h1>Say hi</h1>
      <p>
        The diary doesn't sell anything, but the person writing it does answer messages. Email
        is fastest — I'm in Malaysia (UTC+8).
      </p>
      <ul class="channels">
        {
          channels.map((channel) => (
            <li class="channel">
              <span class="label">{channel.label}</span>
              <a href={channel.href}>{channel.display}</a>
            </li>
          ))
        }
      </ul>

      <div class="fund">
        <img
          src="/images/kit/coffee-2026-10-07.svg"
          alt=""
          width="150"
          height="120"
          class="coffee"
        />
        <h2>Fund the ink</h2>
        <p>
          The diary is free. The coffee that fuels it is not. So for readers who just want to
          <em>give me money without me servicing them</em> — this one's for you, WAHAHA.
        </p>
        <p class="text-muted">
          Hosting is already free; tips go straight to the coffee supply and the author's
          ego.
        </p>
        {
          links.kofi && (
            <p>
              <a class="btn" href={links.kofi}>Buy the author a cup →</a>
            </p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .channels {
    list-style: none;
    margin: var(--space-4) 0 var(--space-3);
    padding: 0;
  }

  .channel {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding-block: 0.875rem;
    border-top: 1.5px solid var(--ink-20);
  }

  .channel .label {
    margin: 0;
  }

  .channel:last-child {
    border-bottom: 1.5px solid var(--ink-20);
  }

  .fund {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 2px dotted var(--ink-30);
  }

  .coffee {
    display: block;
    margin-bottom: var(--space-3);
  }
</style>
