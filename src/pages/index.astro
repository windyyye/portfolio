---
/**
 * Temporary stand-in home page so `npm run build` works.
 * Issue #2 replaces this with the shared layout and real placeholder pages.
 */
import { site } from '../config';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name}</title>
    <meta name="description" content={site.description} />
  </head>
  <body>
    <main>
      <h1>{site.name}</h1>
      <p>{site.tagline}</p>
      <p>Scaffold in progress — placeholder pages land in issue #2.</p>
    </main>
  </body>
</html>
