---
/**
 * Home — DESIGN.md §8: tall masthead, one-line diary intro, dotted-leader TOC
 * of the latest entries. No offer cards, no conversion goals (spec v2).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';

const entries = (await getCollection('log')).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);

// Newest first for display; numbers stay tied to creation order.
const numbered = entries
  .map((entry, index) => ({ entry, number: index + 1 }))
  .reverse()
  .slice(0, 5);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const entryNo = (n: number) => `No. ${String(n).padStart(3, '0')}`;
---

<BaseLayout title="Home" tall>
  <img
    slot="masthead-art"
    src="/images/kit/masthead-peep-2026-10-06.svg"
    alt=""
    width="73"
    height="200"
    class="masthead-art"
  />
  <section class="section">
    <div class="container">
      <p class="intro measure">{site.tagline}</p>
      <p class="margin-note">Vol. I — wander anywhere. — W.</p>

      <h2 class="toc-heading label">In this volume</h2>
      <ul class="toc">
        {
          numbered.map(({ entry, number }) => (
            <li>
              <a class="toc-row" href={`/log/${entry.id}/`}>
                <span class="mono num">{entryNo(number)}</span>
                <span class="toc-title">{entry.data.title}</span>
                <span class="leader" aria-hidden="true" />
                <span class="numeral">{formatDate(entry.data.date)}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a class="toc-row" href="/log/">
            <span class="toc-title">The whole journal →</span>
            <span class="leader" aria-hidden="true" />
            <span class="numeral">I</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    font-size: 1.35rem;
    line-height: 1.5;
    max-width: 38ch;
    margin-block: var(--space-4) var(--space-2);
  }

  .margin-note {
    font-family: var(--font-hand);
    font-size: 1.25rem;
    color: var(--ink-70);
    transform: rotate(-1.5deg);
    margin: 0 0 var(--space-5);
  }

  .toc-heading {
    margin-bottom: var(--space-2);
  }

  .num {
    color: var(--ink-70);
  }

  @media (min-width: 1100px) {
    .margin-note {
      position: absolute;
      right: 4vw;
      top: var(--space-6);
      max-width: 14ch;
    }
  }
</style>
