---
/**
 * Build log post — DESIGN.md §8: H1, mono date line, article at 65ch measure.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('log');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = post.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <article class="section">
    <div class="container measure">
      <p class="label">Build log</p>
      <h1>{post.data.title}</h1>
      <time
        class="mono text-muted"
        datetime={post.data.date.toISOString().slice(0, 10)}
      >
        {formatDate}
      </time>
      <div class="prose">
        <Content />
      </div>
      <p class="back-link"><a href="/log/">← All posts</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  time {
    display: block;
    font-size: 0.875rem;
    margin: -0.5rem 0 2rem;
  }

  .prose :global(h2) {
    font-size: 1.25rem;
    margin-top: 2rem;
  }

  .back-link {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
</style>
