---
/**
 * Journal entry — DESIGN.md §8: entry header (No. · date · stage stamp),
 * Fraunces title, Literata body on the book page.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Stamp from '../../components/Stamp.astro';

export async function getStaticPaths() {
  const posts = await getCollection('log');
  const numbered = posts
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
    .map((post, index) => ({ post, number: index + 1 }));
  return numbered.map(({ post, number }) => ({
    params: { id: post.id },
    props: { post, number },
  }));
}

const { post, number } = Astro.props;
const { Content } = await render(post);

const formatDate = post.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const entryNo = `No. ${String(number).padStart(3, '0')}`;
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <article class="section">
    <div class="container measure">
      <p class="entry-header">
        <span>{entryNo}</span>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate}</time>
        {
          post.data.stage && (
            <>
              <span aria-hidden="true">·</span>
              <Stamp stage={post.data.stage} tone={number % 2 === 0 ? 'blue' : 'pink'} />
            </>
          )
        }
      </p>
      <h1>{post.data.title}</h1>
      <div class="prose">
        <Content />
      </div>
      <p class="back-link mono"><a href="/log/">← The journal</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .back-link {
    margin-top: var(--space-5);
    font-size: var(--size-label);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>
