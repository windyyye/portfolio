---
/**
 * Journal index — DESIGN.md §8: the full TOC of entries,
 * `No. . . . title . . . date . . . stage`.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Stamp from '../../components/Stamp.astro';

const entries = (await getCollection('log')).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);

const numbered = entries.map((entry, index) => ({ entry, number: index + 1 })).reverse();

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const entryNo = (n: number) => `No. ${String(n).padStart(3, '0')}`;
---

<BaseLayout
  title="Journal"
  description="The journal: dated entries on building, learning, and deciding — in progress and in public."
>
  <section class="section">
    <div class="container measure-wide">
      <div class="journal-header">
        <div>
          <p class="label">Vol. I · the journal</p>
          <h1>Everything so far</h1>
        </div>
        <img
          src="/images/masthead-book-sprout.svg"
          alt=""
          width="88"
          height="66"
          class="sprout"
        />
      </div>
      <ul class="toc">
        {
          numbered.map(({ entry, number }) => (
            <li>
              <a class="toc-row" href={`/log/${entry.id}/`}>
                <span class="mono num">{entryNo(number)}</span>
                <span class="toc-title">{entry.data.title}</span>
                <span class="leader" aria-hidden="true" />
                {entry.data.stage && (
                  <span class="stage">
                    <Stamp stage={entry.data.stage} tone={number % 2 === 0 ? 'blue' : 'pink'} />
                  </span>
                )}
                <span class="numeral">{formatDate(entry.data.date)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .measure-wide {
    max-width: 72ch;
  }

  .journal-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .sprout {
    flex-shrink: 0;
    margin-bottom: var(--space-1);
  }

  .num,
  .numeral {
    color: var(--ink-70);
    white-space: nowrap;
  }
</style>
